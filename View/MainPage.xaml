<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:MetanetA_MobileApp.Model"
             xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels"
             xmlns:controls="clr-namespace:MetanetA_MobileApp.View"
             xmlns:ui="clr-namespace:MetanetA_MobileApp.View.Controls"
             x:Class="MetanetA_MobileApp.View.MainPage" x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource BrandCanvas}" Shell.NavBarIsVisible="False" SafeAreaEdges="All">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource BrandCanvas}"
                                   StatusBarStyle="DarkContent" ApplyOn="OnPageNavigatedTo" />
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0" SafeAreaEdges="None">
        <Border Grid.Row="0" Style="{StaticResource BrandCard}" Margin="18,14,18,0" MaximumWidthRequest="560">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="16" SafeAreaEdges="None">
                <Grid ColumnDefinitions="*,44" ColumnSpacing="12" SafeAreaEdges="None">
                    <Image Source="masters_club_icon.png" WidthRequest="184" HeightRequest="46" Aspect="AspectFit"
                           HorizontalOptions="Start" VerticalOptions="Center"
                           SemanticProperties.Description="Matanat A Ustalar Klubu" />
                    <ImageButton Grid.Column="1" Source="noticifation_button.png" WidthRequest="44" HeightRequest="44"
                                 Padding="11" BackgroundColor="{StaticResource BrandCanvas}" CornerRadius="14"
                                 Aspect="AspectFit" SemanticProperties.Description="Bildirişlər" />
                </Grid>
                <Border Grid.Row="1" BackgroundColor="{StaticResource BrandCanvas}" Stroke="{StaticResource BrandLine}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,0" MinimumHeightRequest="54">
                    <Grid ColumnDefinitions="20,*,44" ColumnSpacing="10" SafeAreaEdges="None">
                        <Image Source="brand_search.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" InputTransparent="True" />
                        <ui:BrandSearchEntry Grid.Column="1" AutomationId="MainProductSearch" Placeholder="Məhsul axtar..."
                                             Text="{Binding SearchText, Mode=TwoWay}" FontFamily="OpenSansRegular" FontSize="14"
                                             TextColor="{StaticResource BrandInk}" PlaceholderColor="{StaticResource BrandMuted}"
                                             BackgroundColor="Transparent" ClearButtonVisibility="Never" ReturnType="Search"
                                             VerticalTextAlignment="Center" MinimumWidthRequest="0" MinimumHeightRequest="48"
                                             SemanticProperties.Description="Məhsul axtarışı" />
                        <ImageButton Grid.Column="2" Source="brand_close.png" WidthRequest="44" HeightRequest="44"
                                     Padding="12" Aspect="AspectFit" BackgroundColor="Transparent"
                                     Command="{Binding ClearMainSearchCommand}" SemanticProperties.Description="Axtarışı təmizlə">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding SearchText}" Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding SearchText}" Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" SafeAreaEdges="None">
            <ScrollView SafeAreaEdges="None" VerticalScrollBarVisibility="Never">
                <ScrollView.Triggers>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsSearchResultsVisible}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </ScrollView.Triggers>
                <VerticalStackLayout Padding="18,16,18,20" Spacing="12" MaximumWidthRequest="596" SafeAreaEdges="None">
                    <Label Text="Sizin üçün" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource BrandMuted}" Margin="2,0,0,2" />
                    <ui:DashboardCard AutomationId="BonusCard" Title="Bonuslar" Subtitle="Bonuslarınızı izləyin"
                                      Artwork="dashboard_bonus.png" Command="{Binding GoTobonusPageCommand}" />
                    <ui:DashboardCard AutomationId="AdsCard" Title="Reklamlar" Subtitle="Məhsul və xidmətlərlə tanış olun"
                                      Artwork="dashboard_ads.png" Command="{Binding CampaignsCommand}" />
                    <ui:DashboardCard AutomationId="TrainingCard" Title="Təlim və videolar" Subtitle="Bilik və bacarıqlarınızı artırın"
                                      Artwork="dashboard_training.png" Command="{Binding TrainingCommand}" />
                    <ui:DashboardCard AutomationId="NewsCard" Title="Yeniliklər" Subtitle="Ən son xəbərlərlə tanış olun"
                                      Artwork="dashboard_news.png" Command="{Binding AdsCommand}" />
                    <ui:DashboardCard AutomationId="CampaignCard" Title="Kampaniyalar" Subtitle="Sizə uyğun təklifləri kəşf edin"
                                      Artwork="dashboard_campaign.png" Command="{Binding CampaignsCommand}" />
                </VerticalStackLayout>
            </ScrollView>
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSearchResultsVisible}" Padding="18,16,18,12"
                  RowSpacing="12" SafeAreaEdges="None">
                <Label Text="Axtarış nəticələri" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource BrandMuted}" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:SalesItem">
                            <Border Style="{StaticResource BrandCard}" Margin="0,0,0,10" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenSuggestedProductCommand, Source={RelativeSource AncestorType={x:Type controls:MainPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" SafeAreaEdges="None">
                                    <Border BackgroundColor="{StaticResource BrandCanvas}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12" WidthRequest="52" HeightRequest="52" Padding="6">
                                        <Image Source="{Binding Image}" Aspect="AspectFit" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" SafeAreaEdges="None">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14"
                                               TextColor="{StaticResource BrandInk}" LineBreakMode="WordWrap" />
                                        <Label Text="Məhsul" Style="{StaticResource BrandCaption}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:0.##} ₼'}"
                                           FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center"
                                           TextColor="{StaticResource BrandGreen}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
        <controls:BottomMenu Grid.Row="2" VerticalOptions="End" />
    </Grid>
</ContentPage>
