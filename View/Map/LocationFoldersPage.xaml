<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:MetanetA_MobileApp.Model"
             x:Class="MetanetA_MobileApp.View.Map.LocationFoldersPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="18,20,18,14" Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="←"
                        Clicked="OnBackClicked"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#111827"
                        BackgroundColor="White"
                        BorderColor="#E5E7EB"
                        BorderWidth="1"
                        CornerRadius="14" />

                <Label Grid.Column="1"
                       Text="Məkanlar"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       VerticalTextAlignment="Center" />
            </Grid>

            <Label Text="Məkanları görmək üçün qovluq seçin."
                   FontSize="14"
                   TextColor="#6B7280" />
        </VerticalStackLayout>

        <CollectionView x:Name="FoldersList"
                        Grid.Row="1"
                        Margin="18,0,18,18"
                        SelectionMode="Single"
                        SelectionChanged="OnFolderSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:LocationFolderItem">
                    <Border Padding="16"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Label Text="📁"
                                   FontSize="28"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding LocationCountText}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   TextColor="#9CA3AF"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
