<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:MetanetA_MobileApp.Model"
             xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels"
             xmlns:controls="clr-namespace:MetanetA_MobileApp.View"
             x:Class="MetanetA_MobileApp.View.ProfilePage" x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource BrandCanvas}" Shell.NavBarIsVisible="False" SafeAreaEdges="Container">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource BrandCanvas}"
                                   StatusBarStyle="DarkContent" ApplyOn="OnPageNavigatedTo" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <Style x:Key="ProfileRow" TargetType="Border" BasedOn="{StaticResource BrandCard}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="72" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        </Style>
        <Style x:Key="ProfileTap" TargetType="Button">
            <Setter Property="Text" Value="" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="MinimumHeightRequest" Value="72" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
        <Style x:Key="ProfileRowText" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None">
        <VerticalStackLayout Grid.Row="0" Padding="20,18,20,14" Spacing="4" SafeAreaEdges="None">
            <Label Text="Profil" Style="{StaticResource BrandHeading}" />
            <Label Text="Hesabınızı buradan idarə edin" Style="{StaticResource BrandCaption}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" SafeAreaEdges="None" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,0,18,20" Spacing="12" MaximumWidthRequest="596" SafeAreaEdges="None">
                <Border Style="{StaticResource BrandCard}" Padding="20">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" SafeAreaEdges="None">
                        <Border Stroke="{StaticResource BrandLine}" StrokeThickness="2" Padding="0"
                                BackgroundColor="{StaticResource BrandSoft}" StrokeShape="RoundRectangle 999"
                                WidthRequest="100" HeightRequest="100">
                            <Image Source="{Binding ProfileImage}" Aspect="AspectFill" WidthRequest="96" HeightRequest="96"
                                   HorizontalOptions="Center" VerticalOptions="Center" SemanticProperties.Description="Profil şəkli">
                                <Image.Clip><EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" /></Image.Clip>
                            </Image>
                        </Border>
                        <Button Text="Profil şəklini dəyiş" Style="{StaticResource BrandAction}" Command="{Binding ChangePhotoCommand}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource ProfileRow}">
                    <Grid SafeAreaEdges="None">
                        <Grid ColumnDefinitions="40,*,18" ColumnSpacing="12" SafeAreaEdges="None" Padding="16,14" InputTransparent="True">
                            <Image Source="brand_account.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Şəxsi məlumatlarım" Style="{StaticResource ProfileRowText}" />
                            <Image Grid.Column="2" Source="brand_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        </Grid>
                        <Button Style="{StaticResource ProfileTap}" Command="{Binding PersonalInfoCommand}"
                                SemanticProperties.Description="Şəxsi məlumatlarım" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProfileRow}">
                    <Grid SafeAreaEdges="None">
                        <Grid ColumnDefinitions="40,*,18" ColumnSpacing="12" SafeAreaEdges="None" Padding="16,14" InputTransparent="True">
                            <Image Source="brand_bag.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Sifarişlərim" Style="{StaticResource ProfileRowText}" />
                            <Image Grid.Column="2" Source="brand_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        </Grid>
                        <Button Style="{StaticResource ProfileTap}" Command="{Binding OrdersCommand}"
                                SemanticProperties.Description="Sifarişlərim" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProfileRow}">
                    <Grid SafeAreaEdges="None">
                        <Grid ColumnDefinitions="40,*,18" ColumnSpacing="12" SafeAreaEdges="None" Padding="16,14" InputTransparent="True">
                            <Image Source="brand_payment.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Kartlarım" Style="{StaticResource ProfileRowText}" />
                            <Image Grid.Column="2" Source="brand_chevron.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        </Grid>
                        <Button Style="{StaticResource ProfileTap}" Command="{Binding CardsCommand}"
                                SemanticProperties.Description="Kartlarım" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource BrandCard}">
                    <VerticalStackLayout Spacing="14" SafeAreaEdges="None">
                        <Label Text="Son alışlar" Style="{StaticResource ProfileRowText}" FontSize="16" />
                        <VerticalStackLayout Spacing="6" Padding="12,12" IsVisible="False" SafeAreaEdges="None">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding PurchaseHistory.Count}" Value="0">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                            <Image Source="brand_bag.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                            <Label Text="Hələ alış tarixçəsi yoxdur" FontFamily="OpenSansSemibold" FontSize="14"
                                   TextColor="{StaticResource BrandInk}" HorizontalTextAlignment="Center" />
                            <Label Text="Son alışlarınız burada görünəcək" Style="{StaticResource BrandCaption}" FontSize="12" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PurchaseHistory}" Spacing="10" SafeAreaEdges="None">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="model:PurchaseHistoryItem">
                                    <Border BackgroundColor="{StaticResource BrandCanvas}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12" RowSpacing="6" SafeAreaEdges="None">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14"
                                                   TextColor="{StaticResource BrandInk}" LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:0.##} ₼'}"
                                                   FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource BrandGreen}" />
                                            <Label Grid.Row="1" Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" Style="{StaticResource BrandCaption}" FontSize="12" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Quantity, StringFormat='{0} ədəd'}" Style="{StaticResource BrandCaption}" FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomMenu Grid.Row="2" VerticalOptions="End" />
    </Grid>
</ContentPage>
