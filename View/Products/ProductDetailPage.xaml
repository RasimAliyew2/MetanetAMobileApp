<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.ProductsViewModels"
             x:Class="MetanetA_MobileApp.View.Products.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              VerticalOptions="Center">

            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="10"
                    HorizontalOptions="Start">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeclineCommand}"/>
                </Border.GestureRecognizers>

                <Label Text="←"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>

            <Label Grid.Column="1"
                   Text="Məhsul detalları"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#111827"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Margin="0,0,36,0"/>
        </Grid>

        <!-- Şəkil və ad -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="18">

            <VerticalStackLayout Spacing="10">

                <Image Source="{Binding ProductImageSource}"
                       HeightRequest="180"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding Name}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>

        <!-- API-dəki HTML burada həqiqi HTML kimi render olunur -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="0">

            <WebView x:Name="AboutWebView"
                     Source="{Binding AboutTheProductHtml}"/>
        </Border>
    </Grid>
</ContentPage>
