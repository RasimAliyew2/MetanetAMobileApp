<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.ProductsViewModels"
             xmlns:model="clr-namespace:MetanetA_MobileApp.Model"
             xmlns:controls="clr-namespace:MetanetA_MobileApp.View"
             x:Class="MetanetA_MobileApp.View.Products.ProductPage"
             x:DataType="vm:ProductViewModel"
             BackgroundColor="#F2F6F3"
             Title="Məhsullar"
             Loaded="ContentPage_Loaded">

    <ContentPage.Resources>
        <Color x:Key="Primary">#00CE46</Color>
        <Color x:Key="TextDark">#0B1220</Color>
        <Color x:Key="TextGray">#64748B</Color>
        <Color x:Key="Stroke">#E5E7EB</Color>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Stroke" Value="{StaticResource Stroke}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Opacity="0.10"
                            Radius="14"
                            Offset="0,6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchContainer" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F8FAFC"/>
            <Setter Property="Stroke" Value="{StaticResource Stroke}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <DataTemplate x:Key="ProductCardTemplate"
                      x:DataType="model:ProductItem">
            <Border BackgroundColor="White"
                    Stroke="{StaticResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="10"
                    Margin="0,0,0,10">

                <Grid ColumnDefinitions="70,*,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding BindingContext.SelectProductCommand,
                                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding .}"/>
                    </Grid.GestureRecognizers>

                    <Border BackgroundColor="#F6FFF8"
                            Stroke="{StaticResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="8"
                            HeightRequest="64"
                            WidthRequest="64">

                        <Image Source="{Binding ProductImageSource}"
                               HeightRequest="54"
                               WidthRequest="54"
                               Aspect="AspectFit"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="3"
                                         VerticalOptions="Center">

                        <Label Text="{Binding Name}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}"
                               LineBreakMode="WordWrap"
                               MaxLines="3"/>

                        <Label Text="{Binding MetaText}"
                               FontSize="12"
                               TextColor="{StaticResource TextGray}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding MetaText}"
                                             Value="">
                                    <Setter Property="IsVisible"
                                            Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="22"
                           TextColor="{StaticResource TextGray}"
                           VerticalTextAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="18"
          RowSpacing="12">

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="12">

            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="8">

                <Label Text="Məhsul kateqoriyaları"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}"/>

                <Label Grid.Row="1"
                       Text="Malın adını və ya bir hissəsini yazaraq axtarış edə bilərsiniz."
                       FontSize="13"
                       TextColor="{StaticResource TextGray}"/>

                <Border Grid.Row="2"
                        Style="{StaticResource SearchContainer}">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">

                        <Label Text="⌕"
                               FontSize="18"
                               TextColor="{StaticResource TextGray}"
                               VerticalTextAlignment="Center"/>

                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Malın adını yazın..."
                               PlaceholderColor="{StaticResource TextGray}"
                               TextColor="{StaticResource TextDark}"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               VerticalOptions="Center"/>

                        <ImageButton Grid.Column="2"
                                     Source="close_icon.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     Padding="0"
                                     Command="{Binding ClearSearchCommand}">

                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton"
                                             Binding="{Binding SearchText}"
                                             Value="">
                                    <Setter Property="IsVisible"
                                            Value="False"/>
                                </DataTrigger>

                                <DataTrigger TargetType="ImageButton"
                                             Binding="{Binding SearchText}"
                                             Value="{x:Null}">
                                    <Setter Property="IsVisible"
                                            Value="False"/>
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Error -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding HasError}"
                    VerticalOptions="Start"
                    Margin="0,6,0,0">

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="14"
                           TextColor="#B91C1C"
                           HorizontalTextAlignment="Center"/>

                    <Button Text="Yenidən yoxla"
                            Command="{Binding RetryCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="12"
                            HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Search results -->
            <CollectionView ItemsSource="{Binding SearchResults}"
                            ItemTemplate="{StaticResource ProductCardTemplate}"
                            SelectionMode="None"
                            IsVisible="{Binding IsSearchActive}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20"
                                         Spacing="6">

                        <Label Text="Axtardığınız məhsul tapılmadı"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Başqa ad və ya söz parçası ilə yenidən yoxlayın."
                               FontSize="13"
                               TextColor="{StaticResource TextGray}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- İlk açılışda yalnız ən yuxarı parent folder-lər görünür -->
            <CollectionView ItemsSource="{Binding ParentGroups}"
                            SelectionMode="None"
                            IsVisible="{Binding IsParentViewVisible}">

                <CollectionView.ItemTemplate>
                    <!-- Runtime item ProductRootCategorySection-dir.
                         Köhnə ProductParentSection typed binding-i istifadə edilmir. -->
                    <DataTemplate x:DataType="{x:Null}">

                        <VerticalStackLayout Spacing="8"
                                             Margin="0,0,0,12">

                            <!-- Root folder -->
                            <Border Style="{StaticResource Card}"
                                    Padding="0">

                                <Grid Padding="12"
                                      ColumnDefinitions="64,*,Auto"
                                      ColumnSpacing="12">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ToggleRootCategoryCommand,
                                                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <Border BackgroundColor="#F6FFF8"
                                            Stroke="{StaticResource Stroke}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            HeightRequest="64"
                                            WidthRequest="64">

                                        <Image Source="{Binding IconSource}"
                                               Aspect="AspectFit"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextDark}"
                                               LineBreakMode="WordWrap"
                                               MaxLines="3"/>

                                        <Label Text="{Binding ProductCount,
                                                              StringFormat='Məhsul sayı: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextGray}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="⌄"
                                           FontSize="22"
                                           TextColor="{StaticResource TextGray}"
                                           VerticalTextAlignment="Center">

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsExpanded}"
                                                         Value="False">
                                                <Setter Property="Text"
                                                        Value="›"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>

                            <!-- Root kliklənənə qədər SubCategories boşdur.
                                 Klikdən sonra yalnız birbaşa child folder-lər yaranır. -->
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                 Spacing="8"
                                                 Margin="12,0,12,0"
                                                 BindableLayout.ItemsSource="{Binding SubCategories}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Null}">

                                        <VerticalStackLayout Spacing="8">

                                            <!-- Child folder -->
                                            <Border BackgroundColor="White"
                                                    Stroke="{StaticResource Stroke}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 16"
                                                    Padding="10">

                                                <Grid ColumnDefinitions="58,*,Auto"
                                                      ColumnSpacing="10"
                                                      VerticalOptions="Center">

                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.ToggleSubCategoryCommand,
                                                                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>

                                                    <Border BackgroundColor="#F6FFF8"
                                                            Stroke="{StaticResource Stroke}"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 13"
                                                            Padding="6"
                                                            HeightRequest="54"
                                                            WidthRequest="54">

                                                        <!-- ProductSubCategorySection-də ImageUrl yoxdursa
                                                             fallback folder şəkli göstərilir. -->
                                                        <Image Source="{Binding ImageUrl,
                                                                                FallbackValue=product.png,
                                                                                TargetNullValue=product.png}"
                                                               Aspect="AspectFit"/>
                                                    </Border>

                                                    <Label Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextDark}"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="3"
                                                           VerticalTextAlignment="Center"/>

                                                    <Label Grid.Column="2"
                                                           Text="⌄"
                                                           FontSize="21"
                                                           TextColor="{StaticResource TextGray}"
                                                           VerticalTextAlignment="Center">

                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsExpanded}"
                                                                         Value="False">
                                                                <Setter Property="Text"
                                                                        Value="›"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                            </Border>

                                            <!-- Child folder kliklənənə qədər Products boşdur.
                                                 Klikdən sonra yalnız həmin səviyyənin obyektləri yaranır. -->
                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                                 Margin="10,0,0,0"
                                                                 BindableLayout.ItemsSource="{Binding Products}"
                                                                 BindableLayout.ItemTemplate="{StaticResource ProductCardTemplate}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>

        <controls:BottomMenu Grid.Row="2"
                             VerticalOptions="End"
                             Margin="0,0,0,6"/>
    </Grid>
</ContentPage>
