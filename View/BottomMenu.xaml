<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MetanetA_MobileApp.View.BottomMenu"
             MinimumHeightRequest="72"
             BackgroundColor="White"
             SafeAreaEdges="None">

    <ContentView.Resources>
        <Style x:Key="BottomMenuItem" TargetType="Grid">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="SafeAreaEdges" Value="None" />
        </Style>

        <Style x:Key="BottomMenuIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="28" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="Aspect" Value="AspectFit" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <Style x:Key="BottomMenuText" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="#69756F" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <!-- Full-cell buttons preserve accessible, generous touch targets. -->
        <Style x:Key="BottomMenuTapButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Text" Value="" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#1815803D" />
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Scale" Value="0.98" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="1,Auto"
          RowSpacing="0"
          BackgroundColor="White"
          SafeAreaEdges="None">
        <BoxView Grid.Row="0"
                 HeightRequest="1"
                 BackgroundColor="#E6EBE9"
                 InputTransparent="True" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*"
              Padding="8,7,8,8"
              ColumnSpacing="0"
              VerticalOptions="Fill"
              SafeAreaEdges="None">

            <Grid Grid.Column="0"
                  Style="{StaticResource BottomMenuItem}">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="Transparent"
                        SafeAreaEdges="None"
                        InputTransparent="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding MenuState.IsHomeSelected}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F7ED" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     SafeAreaEdges="None"
                                     InputTransparent="True">
                    <Image Source="house_button.png"
                           Style="{StaticResource BottomMenuIcon}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding MenuState.IsHomeSelected}"
                                         Value="True">
                                <Setter Property="Source" Value="house_button_green.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="Əsas"
                           Style="{StaticResource BottomMenuText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding MenuState.IsHomeSelected}"
                                         Value="True">
                                <Setter Property="TextColor" Value="#15803D" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Style="{StaticResource BottomMenuTapButton}"
                        Command="{Binding HomeCommand}"
                        SemanticProperties.Description="Əsas səhifə" />
            </Grid>

            <Grid Grid.Column="1"
                  Style="{StaticResource BottomMenuItem}">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="Transparent"
                        SafeAreaEdges="None"
                        InputTransparent="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding MenuState.IsProductsSelected}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F7ED" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     SafeAreaEdges="None"
                                     InputTransparent="True">
                    <Image Source="products.png"
                           Style="{StaticResource BottomMenuIcon}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding MenuState.IsProductsSelected}"
                                         Value="True">
                                <Setter Property="Source" Value="products_green.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="Məhsullar"
                           Style="{StaticResource BottomMenuText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding MenuState.IsProductsSelected}"
                                         Value="True">
                                <Setter Property="TextColor" Value="#15803D" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Style="{StaticResource BottomMenuTapButton}"
                        Command="{Binding ProductsCommand}"
                        SemanticProperties.Description="Məhsullar" />
            </Grid>

            <Grid Grid.Column="2"
                  Style="{StaticResource BottomMenuItem}">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="Transparent"
                        SafeAreaEdges="None"
                        InputTransparent="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding MenuState.IsQrSelected}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F7ED" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     SafeAreaEdges="None"
                                     InputTransparent="True">
                    <Image Source="qr_code.png"
                           Style="{StaticResource BottomMenuIcon}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding MenuState.IsQrSelected}"
                                         Value="True">
                                <Setter Property="Source" Value="qr_code_green.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="QR"
                           Style="{StaticResource BottomMenuText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding MenuState.IsQrSelected}"
                                         Value="True">
                                <Setter Property="TextColor" Value="#15803D" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Style="{StaticResource BottomMenuTapButton}"
                        Command="{Binding QrCommand}"
                        SemanticProperties.Description="QR kodu skan et" />
            </Grid>

            <Grid Grid.Column="3"
                  Style="{StaticResource BottomMenuItem}">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="Transparent"
                        SafeAreaEdges="None"
                        InputTransparent="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding MenuState.IsProfileSelected}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F7ED" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     SafeAreaEdges="None"
                                     InputTransparent="True">
                    <Image Source="profile.png"
                           Style="{StaticResource BottomMenuIcon}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding MenuState.IsProfileSelected}"
                                         Value="True">
                                <Setter Property="Source" Value="profile_green.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="Profil"
                           Style="{StaticResource BottomMenuText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding MenuState.IsProfileSelected}"
                                         Value="True">
                                <Setter Property="TextColor" Value="#15803D" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Style="{StaticResource BottomMenuTapButton}"
                        Command="{Binding ProfileCommand}"
                        SemanticProperties.Description="Profil" />
            </Grid>

            <Grid Grid.Column="4"
                  Style="{StaticResource BottomMenuItem}">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="Transparent"
                        SafeAreaEdges="None"
                        InputTransparent="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding MenuState.IsOtherSelected}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F7ED" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     SafeAreaEdges="None"
                                     InputTransparent="True">
                    <Image Source="other_icon.png"
                           Style="{StaticResource BottomMenuIcon}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding MenuState.IsOtherSelected}"
                                         Value="True">
                                <Setter Property="Source" Value="other_green.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="Digər"
                           Style="{StaticResource BottomMenuText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding MenuState.IsOtherSelected}"
                                         Value="True">
                                <Setter Property="TextColor" Value="#15803D" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Style="{StaticResource BottomMenuTapButton}"
                        Command="{Binding OtherCommand}"
                        SemanticProperties.Description="Digər bölmələr" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>
