<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="BrandCanvas">#F5F7FA</Color>
    <Color x:Key="BrandSurface">#FFFFFF</Color>
    <Color x:Key="BrandInk">#16251D</Color>
    <Color x:Key="BrandMuted">#6B7871</Color>
    <Color x:Key="BrandGreen">#15803D</Color>
    <Color x:Key="BrandSoft">#E8F7ED</Color>
    <Color x:Key="BrandLine">#E7EDE9</Color>
    <Style x:Key="BrandCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandSurface}" />
        <Setter Property="Stroke" Value="{StaticResource BrandLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#16251D" Opacity="0.04" Radius="12" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BrandHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
    </Style>
    <Style x:Key="BrandCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource BrandMuted}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="BrandAction" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandSoft}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextTransform" Value="None" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
</ResourceDictionary>
